# Pick ONE of the two DATABASE_URL formats below.

# Option A — local Docker Postgres (no Supabase account needed, matches
# `npm run db:up`).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/inventory_reservation

# Option B — Supabase pooled ("Transaction pooler") connection string.
# This is the active default. Use the POOLED connection, not the direct
# one — see README "Setting up Supabase and running the migration" for why.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

PORT=3000
RESERVATION_TTL_MINUTES=10
